# Secrets. Locally: copy to .dev.vars (not committed). In production: the
# deploy button asks for these, or set them with `pnpm exec wrangler secret put <NAME>`.

# Comma-separated emails of superadmins (they add the admins who create conferences)
SUPERADMIN="you@example.org"

# Random secret for sign-in sessions: `openssl rand -base64 32`
BETTER_AUTH_SECRET="change-me"

# Email (Scaleway Transactional Email) is added later, once you have verified
# your sending domain: see the README, Email. Until then, the app works but
# can't send sign-in codes (locally they are printed to the console).
# SCW_SECRET_KEY=""
# SCW_PROJECT_ID=""

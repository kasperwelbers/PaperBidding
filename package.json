{
  "name": "conference-planner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @cp/api --filter @cp/web dev",
    "build": "pnpm --filter @cp/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @cp/db generate",
    "db:migrate:local": "pnpm --filter @cp/api db:migrate:local",
    "deploy": "pnpm build && pnpm --filter @cp/api deploy",
    "dev:remote-ai": "pnpm --parallel --filter @cp/api --filter @cp/web dev:remote-ai"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}

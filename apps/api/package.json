{
  "name": "@cp/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "wrangler dev -c ../../wrangler.jsonc --local --var ENVIRONMENT:development --var EMBEDDINGS:dev-hash --var BETTER_AUTH_URL:http://localhost:5180",
    "dev:remote-ai": "wrangler dev -c ../../wrangler.jsonc --var ENVIRONMENT:development --var EMBEDDINGS:workers-ai --var BETTER_AUTH_URL:http://localhost:5180",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "types": "wrangler types -c ../../wrangler.jsonc --strict-vars false worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB -c ../../wrangler.jsonc --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB -c ../../wrangler.jsonc --remote"
  },
  "dependencies": {
    "@cp/adapter-scholarone": "workspace:*",
    "@cp/db": "workspace:*",
    "@cp/institutions": "workspace:*",
    "@cp/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conference-planner",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // The built SPA (apps/web) is served by this same Worker, so the API and the
  // app share one origin. /api/* goes to the Worker, everything else to the SPA
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "conference-planner",
      // replace with the id from `wrangler d1 create conference-planner`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  // raw uploaded files (imports)
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "conference-planner-files" }],

  // import processing (parsing, embeddings) in chunks
  "queues": {
    "producers": [{ "binding": "IMPORTS", "queue": "conference-planner-imports" }],
    "consumers": [{ "queue": "conference-planner-imports", "max_batch_size": 10 }]
  },

  // embeddings (Workers AI; remote only: `pnpm dev` uses a local stand-in,
  // `pnpm dev:remote-ai` the real one)
  "ai": { "binding": "AI", "remote": true }
  // Secrets (not in this file): SUPERADMIN. Locally in .dev.vars, in
  // production with `wrangler secret put SUPERADMIN`
}
